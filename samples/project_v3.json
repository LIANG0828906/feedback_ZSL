              {
                "name": "X-Forwarded-Prefix",
                "value": "/api/v1"
              }
            ]
          },
          "upstreams": [
            "u-blue",
            "u-green",
            "u-gold",
            "u-standby"
          ]
        },
        {
          "id": "R-api-root",
