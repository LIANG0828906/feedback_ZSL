{
  "listen": {
    "host": "127.0.0.1",
    "port": 8090
  },
  "database": {
    "driver": "auto",
    "legacy_connection_string": "DSN=LegacyDSN;DATABASE=OrdersLegacy;",
    "shard_connection_string_template": "DSN=ShardedDSN;DATABASE=OrdersShard{shard};",
    "shard_count": 4,
    "connect_timeout_seconds": 5,
    "command_timeout_seconds": 20
  },
  "connection_pool": {
    "max_connections": 24,
    "acquire_timeout_ms": 250,
    "idle_ttl_seconds": 60
  },
  "migration": {
    "batch_size": 500,
    "read_mode_during_migration": "legacy",
    "resume": true
  },
  "reconciliation": {
    "batch_size": 500,
    "in_flight_retry_ms": 120,
    "in_flight_retry_limit": 8
  },
  "rollback": {
    "wait_timeout_seconds": 30,
    "batch_size": 500
  },
  "audit": {
    "sqlite_path": "runtime/audit.db"
  },
  "load": {
    "target_writes_per_second": 20,
    "target_reads_per_second": 30,
    "write_p95_ms": 250,
    "read_p95_ms": 120
  },
  "fault_injection": {
    "enabled": false
  }
}

