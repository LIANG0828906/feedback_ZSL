{
  "service": {
    "host": "127.0.0.1",
    "port": 8000,
    "admin_token": "local-admin-token",
    "business_threads": 16
  },
  "database": {
    "path": "../data/order_guard.db",
    "busy_timeout_ms": 500,
    "connection_limit": 8,
    "operation_timeout_ms": 400,
    "init": true,
    "orders_per_tenant": 150,
    "statuses": ["created", "paid", "shipped", "completed", "cancelled"]
  },
  "tenants": [
    {
      "id": "tenant-alpha",
      "rate_per_second": 30,
      "burst": 10,
      "max_inflight": 4,
      "enabled": true
    },
    {
      "id": "tenant-beta",
      "rate_per_second": 20,
      "burst": 8,
      "max_inflight": 3,
      "enabled": true
    },
    {
      "id": "tenant-gamma",
      "rate_per_second": 20,
      "burst": 8,
      "max_inflight": 3,
      "enabled": true
    },
    {
      "id": "tenant-disabled",
      "rate_per_second": 5,
      "burst": 2,
      "max_inflight": 1,
      "enabled": false
    }
  ],
  "slis": {
    "availability": {
      "kind": "availability",
      "window_seconds": 20,
      "target": 0.98,
      "min_samples": 30,
      "degrade_level": 3,
      "recover_budget_ratio": 0.2
    },
    "latency": {
      "kind": "p99_latency",
      "window_seconds": 20,
      "target_ms": 350,
      "allowed_bad_ratio": 0.01,
      "min_samples": 30,
      "degrade_level": 1,
      "recover_budget_ratio": 0.2
    }
  },
  "degradation": {
    "levels": {
      "0": {
        "name": "normal",
        "query_mode": "full",
        "page_size_cap": 100
      },
      "1": {
        "name": "cache_first",
        "query_mode": "cache_first",
        "page_size_cap": 100
      },
      "2": {
        "name": "slim",
        "query_mode": "slim",
        "page_size_cap": 50
      },
      "3": {
        "name": "minimal",
        "query_mode": "slim",
        "page_size_cap": 20
      }
    }
  },
  "circuit": {
    "failure_threshold": 3,
    "timeout_ratio_threshold": 0.5,
    "timeout_min_requests": 4,
    "window_seconds": 10,
    "open_seconds": 4,
    "half_open_max_calls": 1,
    "open_degrade_level": 2,
    "code": "ORDERS_DB_CIRCUIT_OPEN"
  },
  "capacity": {
    "sample_interval_ms": 250,
    "worker_threads": 8,
    "thread_occupancy_threshold": 0.85,
    "queue_depth_threshold": 6,
    "sqlite_busy_events_threshold": 2,
    "enter_after_samples": 2,
    "recover_thread_occupancy": 0.3,
    "recover_queue_depth": 2,
    "sqlite_busy_recover_events": 0,
    "recover_after_samples": 4,
    "page_size_cap": 10,
    "degrade_level": 3,
    "code": "CAPACITY_PROTECTED"
  },
  "query": {
    "default_page_size": 20,
    "max_page_size": 100
  },
  "fallback": {
    "order": ["cache", "slim_snapshot"],
    "cache_ttl_seconds": 10,
    "cache_max_entries": 256,
    "snapshot_max_orders_per_tenant": 1000
  },
  "audit": {
    "path": "../data/order_guard.db",
    "run_id": null
  },
  "sli_evaluation_interval_ms": 250
}
